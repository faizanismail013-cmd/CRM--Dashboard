# ============================================
# SmartPay CRM — Environment Configuration
# ============================================
# Copy this file to .env and replace all placeholder values

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Resend Email (Optional alternative)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP Email Configuration (Nodemailer)
# Use Gmail, Outlook, Amazon SES, Brevo, Mailgun, or custom SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SmartPay India HR <your_email@gmail.com>"

# Session Secret
SESSION_SECRET=smartpay-crm-secret-change-me-in-production

# App Configuration
PORT=3000
NODE_ENV=development

